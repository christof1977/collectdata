[Unit]
Description=Datensammler
After=network-online.target
[Service]
Type=simple
User=heizung
Group=heizung
UMask=007
EnvironmentFile=/home/heizung/collectdata/oekofen2mqtt.env
#ExecStart=/home/heizung/collectdata/env/bin/python3 /home/heizung/collectdata/oekofen2mqtt.py
ExecStart=/usr/bin/python3 /home/heizung/collectdata/oekofen2mqtt.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
